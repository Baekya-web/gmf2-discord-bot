# Discord bot credentials (server-side only; never ship to mobile clients)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ZeroConfig Phase 2: GUILD_ID (or DISCORD_GUILD_ID) now ONLY selects slash
# command registration mode -- set it to register commands to a single guild
# for fast iteration (applicationGuildCommands), or leave it unset to
# register global commands (applicationCommands). It is no longer used to
# restrict which guild /link or share routing may target at runtime; that is
# now verified dynamically per-request against the live Discord API and the
# GMF2 database (discord_groups), not this static value.
DISCORD_GUILD_ID=

# Supabase project URL used by /link to call:
#   ${SUPABASE_URL}/functions/v1/redeem-link-code
SUPABASE_URL=

# /link -> Supabase redeem-link-code shared secret.
# This value is sent as the x-bot-secret header and must match
# Deno.env.get("BOT_SHARED_SECRET") in the Supabase Edge Function.
BOT_SHARED_SECRET=

# GMF_DISCORD_BOT_SHARE_SECRET authenticates inbound share requests this bot
# receives at POST /discord/share (checked against the Authorization: Bearer
# header). This bot does NOT read GMF_DISCORD_BOT_SHARE_URL -- that variable
# belongs to the gmf2 Supabase Edge Functions (quest-completed,
# send-daily-log), which use it to know where to POST share requests TO.
# Do not set GMF_DISCORD_BOT_SHARE_URL here; it has no effect on this process.
GMF_DISCORD_BOT_SHARE_SECRET=

# Optional existing flows
SUPABASE_LEADERBOARD_URL=

# SUPABASE_LINK_STATUS_URL is intentionally unusable by this bot: the bot has
# no per-user Supabase access token, and discord-link-status (the ZeroConfig
# Phase 1 endpoint) only authenticates via Authorization: Bearer <user access
# token> -> supabase.auth.getUser(), never a bot-supplied userId. Leave this
# unset. verifyLinkedUser() is kept for a possible future bot-compatible
# status endpoint, but currently short-circuits to { ok: true, skipped: true }
# whenever this is unset.
SUPABASE_LINK_STATUS_URL=
SUPABASE_ANON_KEY=
PORT=10000

# ZeroConfig Phase 2 allowlist semantics: if set, only these channel IDs may
# receive share posts (operator restriction) even when a user's DB-linked
# destination points elsewhere. If left EMPTY, routing is no longer denied by
# default -- any DB-linked destination is allowed, gated instead by the live
# guild/channel fetch and the bot's actual ViewChannel/SendMessages
# permission in that channel (see validateTargetChannel()).
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_DEFAULT_RESULT_CHANNEL_ID=
